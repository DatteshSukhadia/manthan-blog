{
  "name": "manthan-chat-vercel",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": "22.x" },
  "scripts": {
    "prepare:source": "node scripts/prepare.mjs",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "node scripts/migrate.mjs",
    "build": "npm run prepare:source && npm run db:generate && npm run db:migrate && next build",
    "start": "next start --hostname 0.0.0.0 --port ${PORT:-3000}"
  },
  "dependencies": {
    "next": "15.5.26",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "lucide-react": "^0.468.0",
    "@prisma/client": "6.19.3",
    "@prisma/adapter-libsql": "6.19.3",
    "@libsql/client": "^0.15.15",
    "bcryptjs": "^3.0.2",
    "nodemailer": "^7.0.0",
    "pdf-parse": "1.1.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pdf-parse": "^1.1.5",
    "prisma": "6.19.3",
    "typescript": "^5.7.0",
    "tailwindcss": "^3.4.17",
    "postcss": "^8.5.0",
    "autoprefixer": "^10.4.20"
  }
}
