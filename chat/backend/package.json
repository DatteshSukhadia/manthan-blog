{
  "name": "manthan-mvp-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "db:generate": "prisma generate --schema ../database/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema ../database/schema.prisma",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "npm run db:generate && npm run db:migrate && npm run db:seed",
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "npm run db:generate && next build",
    "start": "next start --hostname 127.0.0.1 --port 3001"
  },
  "dependencies": {
    "next": "15.5.26",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.2",
    "nodemailer": "^7.0.0",
    "pdf-parse": "1.1.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pdf-parse": "^1.1.5",
    "prisma": "6.19.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
